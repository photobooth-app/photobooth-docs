# Prevent caching of HTML files
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|json)$">
		Header set Cache-Control: "max-age=3600"
    </FilesMatch>

    # Cache static assets for 30 days
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|otf|mp4|webm|webp|ogv)$">
        Header set Cache-Control "private, max-age=86400"
    </FilesMatch>
</IfModule>

# Enable gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>


# 1. Mod_Rewrite aktivieren
RewriteEngine On
RewriteBase /

# 2. Saubere URLs (Clean URLs) ohne .html
# Wenn die angeforderte Datei nicht existiert, aber mit .html, lade diese
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 3. Ordner-Anfragen auf index.html umleiten
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)/$ $1/index.html [L]

